NEXT_PUBLIC_API_URL=http://localhost:3000
# This dashboard's own public URL — used to build absolute links in app/sitemap.js and
# app/robots.js (Jira 16y). Defaults to localhost:3002 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Stripe's publishable key is safe to expose client-side (unlike the secret key, which
# only ever lives in the backend's own .env) — used by dashboard/app/billing/page.jsx to
# load Stripe.js and collect a card. Leave unset to see the "Stripe not configured"
# fallback instead of a card form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
