# --- Core / Phase 1 ---
# Needs to be a replica set, not a standalone mongod — booking creation uses a
# multi-document transaction (src/services/bookingService.js) that only replica sets
# support. MongoDB Atlas's free tier is a replica set by default; a local mongod needs
# `--replSet rs0` plus a one-time `rs.initiate()`.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=booking_call_center
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# --- Encryption (Phase 3) ---
# 32 random bytes, base64-encoded. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Google Calendar OAuth (Phase 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console, and the
# server's mount path: <PUBLIC_HTTPS_URL>/api/calendar/oauth/callback
GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/calendar/oauth/callback

# --- Public URLs the server needs to know about itself (Phases 3 & 4) ---
# Used to build the Google OAuth redirect and the Twilio webhook/stream URLs. In local
# dev, point these at your tunnel (e.g. ngrok) — Twilio and Google both require a
# publicly reachable HTTPS/WSS endpoint, localhost will not work.
PUBLIC_HTTPS_URL=https://your-domain.example.com
PUBLIC_WSS_URL=wss://your-domain.example.com/voice/stream

# --- Twilio (Phase 4) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Separate "from" number for outbound confirmation/reminder SMS (Phase 5) — can be the
# same as a business's inbound voice number, or a shared sender for the whole platform.
TWILIO_SMS_FROM=

# --- Gemini Live (Phase 4) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Plain-text model for the post-call summary/caller-intent pass (plan.md §11 items 2-3) —
# separate from the Live model above, which only does audio.
GEMINI_TEXT_MODEL=gemini-flash-latest
# In-process cap on simultaneous calls (docs/CONCURRENCY.md, Jira 27f) — leave unset
# until the Gemini Live concurrent-session quota for this API key is known (Jira 27m).
# Only correct in PM2 fork mode (one process); do not set this and run PM2 cluster mode.
MAX_CONCURRENT_CALLS=

# --- Payment failure alerts (plan.md §11 item 8, not a live payment flow) ---
# Only needed once something actually creates Stripe PaymentIntents (ROADMAP.md §16) —
# until then, leave unset and /webhooks/stripe/payment-failed just rejects with 503.
STRIPE_WEBHOOK_SECRET=

# --- Platform cost tracking (Platform Overview page, ROADMAP.md §11/§29) ---
# Flat $/minute estimate of what each voice call is costing you (Twilio call minutes +
# Gemini Live session minutes) — NOT fetched from either provider's real usage/billing
# API, just your own numbers × total call duration already recorded per call. Leave
# either unset (0) and its contribution is 0, not guessed; leave both unset and the
# platform dashboard shows "not configured" instead of a misleading $0.00.
TWILIO_PER_MINUTE_RATE=
GEMINI_PER_MINUTE_RATE=

# --- SendGrid (Phase 5, optional — email confirmations are skipped if unset) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Stripe (Phase 11, optional — payment-method collection and charging are skipped
# if unset; plans/trial/usage tracking/invoices all work with no Stripe account at all) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Dashboard (Phase 2) ---
# Consumed by dashboard/.env.local as NEXT_PUBLIC_API_URL; listed here too as a reminder
# that it must point at this server's own PUBLIC_HTTPS_URL in production.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Used to build the customer-facing reschedule/cancel link sent in confirmation/reminder
# messages (src/customerLink.js) — the dashboard's own public URL, not the backend's.
PUBLIC_DASHBOARD_URL=http://localhost:3002
